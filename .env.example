# ==========================================================
# Copia este archivo como .env y completa los valores reales.
# El archivo .env NUNCA debe subirse a un repositorio.
# ==========================================================

# --- Base de datos (PostgreSQL via docker-compose, puerto 5433) ---
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=cambia_esta_contrasena
DB_DATABASE=mototaxi_db

# --- Autenticacion ---
# Genera uno nuevo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_aleatorio_y_largo

# --- CORS ---
# Origenes permitidos, separados por coma. Nunca usar * en produccion.
CORS_ORIGIN=http://localhost:4200

# --- Email (recuperación de contraseña) ---
# Usar una cuenta Gmail con "Contraseña de aplicación" habilitada.
# Ver: https://myaccount.google.com/apppasswords
MAIL_USER=tu_email@gmail.com
MAIL_PASS=xxxx_xxxx_xxxx_xxxx

# --- Frontend ---
# URL base del frontend (para armar el link del email de recuperación)
FRONTEND_URL=http://localhost:4200
